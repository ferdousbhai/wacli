[Unit]
Description=wacli: keep WhatsApp chats as export folders

[Service]
ExecStart=%h/.local/bin/wacli sync --follow
Restart=on-failure
RestartSec=30
# Restarting would not help: 3 is unlinked (run `wacli auth`); 4 is another
# client taking over, a ban or an outdated wacli (`wacli doctor` says which).
RestartPreventExitStatus=3 4

[Install]
WantedBy=default.target
