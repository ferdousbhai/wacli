# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=wacli
pkgver=0.26.2
pkgrel=1
pkgdesc="Keep your WhatsApp chats as iPhone-style export folders, kept up to date"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/wacli"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
options=('!debug' '!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # pin the tag archive's checksum when releasing

_srcdir() { echo "$srcdir/wacli-$pkgver"; }

# Arch's Go flags; cgo (the SQLite session store) gets makepkg's C flags, and
# GCC 15+ rejects go-sqlite3's C without -Wno-error=missing-braces.
_goenv() {
  export CGO_ENABLED=1 GOTOOLCHAIN=local
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS -Wno-error=missing-braces"
  export CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
}

prepare() {
  cd "$(_srcdir)"
  _goenv
  go mod download
}

build() {
  cd "$(_srcdir)"
  _goenv
  go build -o build/wacli ./cmd/wacli
  # The packaged service runs the packaged binary; contrib/ keeps the ~/.local/bin one for go install.
  sed 's|^ExecStart=%h/\.local/bin/wacli |ExecStart=/usr/bin/wacli |' \
    contrib/systemd/wacli-sync.service > build/wacli-sync.service
  grep -qx 'ExecStart=/usr/bin/wacli sync --follow' build/wacli-sync.service
}

check() {
  cd "$(_srcdir)"
  _goenv
  # Without -trimpath: internal/wa's lock test finds client.go through runtime.Caller.
  GOFLAGS="${GOFLAGS/-trimpath /}" go test ./...
}

package() {
  cd "$(_srcdir)"
  install -Dm755 build/wacli "$pkgdir/usr/bin/wacli"
  install -Dm644 build/wacli-sync.service "$pkgdir/usr/lib/systemd/user/wacli-sync.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
